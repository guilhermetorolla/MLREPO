# Copie para .env e preencha:  cp env.exemplo .env
# O .env NÃO vai para o git (está no .gitignore).

# BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Onde VOCÊ recebe as ofertas para aprovar (seu chat privado com o bot).
# Para descobrir o id: mande uma mensagem ao bot e abra
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_APROVACAO=

# Canal onde as aprovadas são publicadas (@nomedocanal).
# O bot precisa ser administrador do canal.
TELEGRAM_CANAL=

# Etiqueta de rastreamento do painel de afiliado.
# Crie uma POR CANAL (telegram, site, instagram) em
# Central de afiliados → Ferramentas → Administrar etiquetas.
# É o que permite saber qual canal converte.
ETIQUETA=

# linkbuilder (padrão, gerador oficial) | montado (só depois da Fase 0 confirmar)
LINK_PROVIDER=linkbuilder

# Só para LINK_PROVIDER=montado. Sai de um link gerado no painel (matt_tool=...).
MATT_TOOL=

# Quantas ofertas por rodada de aprovação
LOTE=10

# Páginas do feed por coleta (18 itens cada)
PAGINAS=5

# 1 = navegador invisível. Deixe VAZIO na primeira execução, para poder logar.
HEADLESS=

# ─── Shopee (API oficial de afiliado) ───
# Peça acesso em affiliate.shopee.com.br → aba Open API.
# A análise é manual e leva de 5 a 15 dias. Depois de aprovado, copie
# o App ID (numérico) e o App Secret do painel.
# Diferente do Mercado Livre, aqui a geração de link é oficial e suportada.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
